# Dependencies + build output
node_modules/
dist/
dist-new/
.vite/
*.tgz

# Claude Code project state (per-machine)
.claude/

# Per-session test/audit output — screenshots, results.json, agent batches,
# the use-case issue tracker — is regenerated per-run and not committed.
# EXCEPTION: the reusable audit/verification SCRIPTS + docs under tools/audit/
# (*.mjs, *.md) ARE tracked — they're the toolkit, not the output.
tools/*
!tools/audit/
tools/audit/*
!tools/audit/*.mjs
!tools/audit/*.md
# EXCEPTION: the blind-model harness driver + docs under tools/blind-harness/
!tools/blind-harness/
tools/blind-harness/*
!tools/blind-harness/*.sh
!tools/blind-harness/*.md

# Generated indices — single source of truth is the YAML files under
# public/styles/ and public/templates/. The four index JSONs are
# regenerated on every build / dev / typecheck / test via npm scripts
# and the Vite plugins, so checking them in just creates merge-conflict
# noise on every YAML edit.
src/templates/catalog-index.json
src/styles/palette-index.json
src/styles/type-pack-index.json
src/styles/effects-pack-index.json

# Test + audit output (specs live in tests/, results don't get committed)
coverage/
test-results/
tests/visual/diffs/
tests/e2e/artifacts/
tests/playwright-report/
tests/ui-audit/screenshots/
tests/ui-audit/reports/
tests/ui-audit/vision/
tests/ui-audit/broad/
tests/ui-audit/template/
tests/ui-audit/catalog/
tests/ui-audit/catalog-cards/
tests/ui-audit/deep/

# Environment + secrets
*.local
.env
.env.*
!.env.example
tokens.json
!tokens.example.json

# Self-hosted deploy state (bind-mounted into the container)
folio-projects/

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
tmp-screens/

# report-lab screenshot artifacts
tools/report-lab/out/

# EXCEPTION: the 100-case design suite (drivers + use cases) under tools/harness-suite/
!tools/harness-suite/
tools/harness-suite/*
!tools/harness-suite/*.py
!tools/harness-suite/*.json
!tools/harness-suite/*.md
# but NOT the regenerated run results (results.json, results-old-engine.json,
# results-prev-<ts>.json, etc. — local run dumps, not source)
tools/harness-suite/results*.json

# Content plans / spreadsheets — authored source material, NOT code.
# Book1.xlsx (178 drafted carousels) was force-pushed out of history on
# 2026-07-20 after landing in this PUBLIC repo. Cache lives outside the
# repo at /root/folio-content/ so it cannot be committed by accident.
*.xlsx
*.xls
tests/commissioning/report/
# Commissioning fixtures are inputs; these are written by the engine at run time.
tests/commissioning/fixtures/projects/.short-links.json
tests/commissioning/fixtures/projects/.library/assets/index.json
tests/commissioning/fixtures/projects/commissioning/designs/_scratch-*.design.yaml
# Projects the asset-manager spec creates and removes at run time.
tests/commissioning/fixtures/projects/_scratch-*/
