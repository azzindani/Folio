# Folio — environment template. Copy to `.env` and edit.
#   cp .env.example .env
#
# Anything left commented out falls back to the default printed in the comment.

# ─── Container role ─────────────────────────────────────────────────────────
# ui    → visual editor only            (:4173)
# mcp   → MCP HTTP API only             (:3333)
# both  → editor + MCP (default)        (:4173 + :3333)
FOLIO_MODE=both

# Skip the 1,935 test suite during `docker build` (passes --build-arg).
# Set to 0 to enforce a green test run before the image is produced.
FOLIO_SKIP_TESTS=1

# ─── Ports (host side) ──────────────────────────────────────────────────────
# Match these to whatever the host has free. The container always uses
# 4173 and 3333 internally regardless.
FOLIO_UI_PORT=4173
FOLIO_MCP_PORT=3333

# ─── Token budget ───────────────────────────────────────────────────────────
# Max tokens per MCP tool response. Lower for tiny local models.
FOLIO_OUTPUT_BUDGET=1000

# ─── Auth (pick ONE) ────────────────────────────────────────────────────────
# Priority at startup: FOLIO_TOKENS_FILE > FOLIO_TOKENS > FOLIO_API_KEY.
# With none of the three set the server runs UNAUTHENTICATED — only do
# that on a private network / behind a firewall.
#
# 1. Multi-token from file (recommended for production):
#    Mount a JSON file like { "claude-desktop": "sk-...", "hermes": "sk-..." }
#    docker-compose.yml mounts ./tokens.json into the container at this path:
FOLIO_TOKENS_FILE=/home/folio/tokens.json
#
# 2. Multi-token inline (good for env-only deployments — no file mount):
# FOLIO_TOKENS=claude-desktop:sk-aaaa,hermes:sk-bbbb,claude-code:sk-cccc
#
# 3. Single shared key (legacy):
# FOLIO_API_KEY=sk-replace-me-with-a-long-random-string

# ─── Caddy TLS profile only ─────────────────────────────────────────────────
# Required for `docker compose --profile tls up`. Set both, then point your
# DNS A record at the VPS IP.
FOLIO_DOMAIN=folio.example.com
FOLIO_ACME_EMAIL=you@example.com
