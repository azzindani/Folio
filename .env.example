# Folio — environment template. Copy to `.env` and edit.
#   cp .env.example .env
#
# Anything left commented out falls back to the default printed in the comment.

# ─── Container role ─────────────────────────────────────────────────────────
# ui    → visual editor only            (:4173)
# mcp   → MCP HTTP API only             (:3333)
# both  → editor + MCP (default)        (:4173 + :3333)
FOLIO_MODE=both

# Skip the 1,935 test suite during `docker build` (passes --build-arg).
# Set to 0 to enforce a green test run before the image is produced.
FOLIO_SKIP_TESTS=1

# ─── Ports (host side) ──────────────────────────────────────────────────────
# Match these to whatever the host has free. The container always uses
# 4173 and 3333 internally regardless.
FOLIO_UI_PORT=4173
FOLIO_MCP_PORT=3333

# ─── Token budget ───────────────────────────────────────────────────────────
# Max tokens per MCP tool response. Lower for tiny local models.
FOLIO_OUTPUT_BUDGET=1000

# ─── Shared filesystem with sibling MCP services ────────────────────────────
# When Folio runs alongside data/ML/office MCP servers, they all mount one
# folder — conventionally /workspace/data — and hand each other file PATHS.
# Folio must mount the SAME host folder at the SAME container path, or a path
# from a sibling names a file that does not exist here: asset_add is refused
# reading the chart PNG, export_design is refused writing the PDF beside it,
# and each refusal is discovered separately, late.
#
# FOLIO_SHARED_DIR  = the HOST folder those services mount (bind source).
# FOLIO_SHARED_DIRS = the CONTAINER paths the sandbox will accept, comma-sep.
# Leave FOLIO_SHARED_DIRS empty to keep the sandbox closed to projects only.
FOLIO_SHARED_DIR=./folio-shared
FOLIO_SHARED_DIRS=/workspace/data

# Extra hosts a direct `asset_fetch` URL may target, on top of the search
# providers' own CDNs. Add the file host a sibling service publishes to, or
# fetching back your own platform's URL is refused as an unknown host.
# Comma-separated; suffix match (example.com covers files.example.com).
FOLIO_ASSET_FETCH_HOSTS=

# ─── Rate limit (POST /mcp) ─────────────────────────────────────────────────
# Per-(token + client-IP) token bucket guarding the single-threaded server: a
# heavy tool call blocks the event loop, so one client's burst can starve the
# rest. Overflow gets HTTP 429 + Retry-After. Defaults below are generous for a
# model driving Folio (it can't out-pace 10/s). Set EITHER to 0 to disable.
FOLIO_RATE_BURST=40
FOLIO_RATE_PER_SEC=10

# ─── Editor / Library front-door hardening (:4173) ──────────────────────────
# The link tools return (open_url / short_url / view_url) is self-authenticating
# — possession = access, no login. These OPT-IN guards make a *leaked* link safe
# to record/share and stop the editor server collapsing under a flood.
#
# IP allow-list — "only me, even if the link leaks, no login". Comma/space list
# of exact IPs and IPv4 CIDRs; a request from any other IP gets 403 before auth.
# Discover your IP: curl https://<host>/__ip  (that route is exempt). Unset = open.
# FOLIO_ALLOW_IPS=203.0.113.7, 10.0.0.0/8
# Per-IP rate limit on the editor server (generous — a page load is many assets).
# Overflow → 429 + Retry-After. Set EITHER to 0 to disable.
FOLIO_EDITOR_RATE_BURST=240
FOLIO_EDITOR_RATE_PER_SEC=80
# Max concurrent EXPENSIVE ops (thumbnail render, full-library scan). Beyond it →
# 503 + Retry-After:1, so a burst can't OOM/peg the container. 0 = unlimited.
FOLIO_EDITOR_MAX_HEAVY=8
# TWO link lifetimes, deliberately separate:
# 1) EDITOR + LIBRARY session (the folio_session cookie) — DURABLE, always-on for
#    you. Default 30 DAYS. Opening any valid link establishes/refreshes it.
FOLIO_EDITOR_TOKEN_TTL_MS=2592000000
# 2) OUTPUT links (the ?token= in a generated open_url/view_url, and the /o/<code>
#    short link) — EPHEMERAL, so a link shown on a recording self-expires. Default
#    30 MIN. To reopen an expired output, open the design from the (always-on)
#    Library — that mints a fresh 30-min link. Opening one still upgrades YOU to the
#    30-day session above (the cookie is minted fresh, not the short output token).
FOLIO_OUTPUT_LINK_TTL_MS=1800000
# Short-link (/o/<code>) lifetime override (ms). Defaults to FOLIO_OUTPUT_LINK_TTL_MS.
# FOLIO_SHORT_LINK_TTL_MS=1800000

# ─── Public URLs (domain is NOT hard-coded — set it here) ───────────────────
# Every generated link derives from these; change them and all links follow.
# FOLIO_EDITOR_URL=https://folio.example.com
# FOLIO_MCP_PUBLIC_URL=https://folio.example.com

# ─── Auth (pick ONE) ────────────────────────────────────────────────────────
# Priority at startup: FOLIO_TOKENS_FILE > FOLIO_TOKENS > FOLIO_API_KEY.
# With none of the three set the server runs UNAUTHENTICATED — only do
# that on a private network / behind a firewall.
#
# 1. Multi-token from file (recommended for production):
#    Mount a JSON file like { "claude-desktop": "sk-...", "hermes": "sk-..." }
#    docker-compose.yml mounts ./tokens.json into the container at this path:
FOLIO_TOKENS_FILE=/home/folio/tokens.json
#
# 2. Multi-token inline (good for env-only deployments — no file mount):
# FOLIO_TOKENS=claude-desktop:sk-aaaa,hermes:sk-bbbb,claude-code:sk-cccc
#
# 3. Single shared key (legacy):
# FOLIO_API_KEY=sk-replace-me-with-a-long-random-string

# ─── JWT signing secret (Harnesses-lab style) ───────────────────────────────
# HS256 secret used to (a) sign the stateless 30-day editor-link tokens that
# open_in_editor / create_design return — no server-side store, survives
# restarts, so a pasted link no longer expires after an hour — and (b) act as a
# master bearer (the raw value opens both MCP and editor). OPTIONAL: when unset
# it falls back to FOLIO_API_KEY, so an existing single-key deploy gains JWTs
# with no change. Set a dedicated long random string to decouple the two.
# FOLIO_JWT_SECRET=replace-me-with-a-long-random-string
# (Session + output-link TTLs are configured above: FOLIO_EDITOR_TOKEN_TTL_MS =
#  the 30-day editor/library session; FOLIO_OUTPUT_LINK_TTL_MS = the 30-min link.)

# ─── OAuth (claude.ai Custom Connector) ─────────────────────────────────────
# Folio exposes /.well-known/oauth-authorization-server, /oauth/authorize,
# /oauth/token, /oauth/register for standards-compliant Authorization Code +
# PKCE. The access token issued bridges to whichever Folio API key the user
# types into the /oauth/authorize login page.
#
# Pin a known client_id so it appears in the registry without needing the
# Dynamic Client Registration step (claude.ai supports both — DCR works
# with the fields left blank).
FOLIO_OAUTH_CLIENT_ID=claude-ai
# Leave blank for a public PKCE-only client (recommended for claude.ai).
# Set to a long random string only if you need a confidential client.
FOLIO_OAUTH_CLIENT_SECRET=

# ─── Caddy TLS profile only ─────────────────────────────────────────────────
# Required for `docker compose --profile tls up`. Set both, then point your
# DNS A record at the VPS IP.
FOLIO_DOMAIN=folio.example.com
FOLIO_ACME_EMAIL=you@example.com

# ─── Editor HTTP Basic Auth (REQUIRED for TLS profile) ──────────────────────
# Browser login in front of the visual editor at `/`. /mcp keeps its own
# Bearer auth, /health stays public. The Caddyfile's basicauth block hard-
# requires these — leave blank and Caddy will refuse to start (deliberate:
# a bare editor on the public internet is never what you want). To disable
# entirely, delete the `basicauth { ... }` blocks from caddy/Caddyfile.
# Generate a hash:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-pass'
# Then escape every `$` as `$$` in the line below (docker compose substitution).
FOLIO_BASIC_USER=admin
FOLIO_BASIC_HASH=

# ─── Upstream release check (auto-update, part 1: DETECT) ───────────────────
# The engine polls the GitHub Releases API (daily by default) and reports the
# result on GET /health and GET /version:
#   {"current":"0.1.1","latest":"0.2.0","update_available":true,...}
# It is NOTIFY-ONLY — it never upgrades or restarts itself. Nothing about you
# is sent: an anonymous, unauthenticated GET. No install id, no telemetry.
# Set 0 for an air-gapped box or any deployment that must not call out.
FOLIO_UPDATE_CHECK=1
# Poll interval in ms (default 86400000 = daily). Floored at 1h.
FOLIO_UPDATE_INTERVAL_MS=
# Override the repo to watch (default azzindani/Folio) — for a fork.
FOLIO_UPDATE_REPO=

# ─── Auto-update (part 2: APPLY) — OFF unless you opt in ────────────────────
# Applying updates is the orchestrator's job, not the server's. To let
# Watchtower pull + restart Folio automatically you must run the PUBLISHED
# image (it cannot rebuild a local source build):
#   FOLIO_IMAGE=ghcr.io/azzindani/folio:latest
#   docker compose --profile autoupdate up -d --pull always --no-build
# Pin a version instead (…/folio:0.1.1) to review each release yourself —
# /version still tells you when a new one exists.
FOLIO_IMAGE=
FOLIO_AUTOUPDATE_INTERVAL_SEC=86400
