# Caddy reverse proxy + automatic HTTPS for Folio.
#
# Variables (set in .env, read by docker-compose.yml):
#   FOLIO_DOMAIN      — public domain pointing at this VPS (DNS A record)
#   FOLIO_ACME_EMAIL  — contact email for Let's Encrypt registration
#   FOLIO_BASIC_USER  — (optional) username for the /files download browser Basic Auth
#   FOLIO_BASIC_HASH  — (optional) bcrypt hash for the /files download browser Basic Auth
#
# Routing:
#   /                       → folio:4173  (visual editor — vite preview)  [?token / cookie — editor is the sole gate]
#   /mcp · /mcp/sse         → folio:3333  (MCP JSON-RPC + tool-result SSE) [Bearer]
#   /.well-known/oauth-*    → folio:3333  (OAuth metadata)                [public]
#   /oauth/*                → folio:3333  (OAuth authorize/token/register) [public]
#   /editor/events?token=*  → folio:3333  (file-change SSE)               [token-validated by MCP]
#   /editor/events          → folio:3333  (SSE, no token)                 [token / cookie — plain 401, no popup]
#   /__project_files/*      → folio:4173  (design YAML fetch)             [token or cookie]
#   /tokens/whoami          → folio:3333  (token sanity check)            [Bearer]
#   /files · /files/*       → /srv/files  (read-only file browser)        [basicauth — separate download surface]
#   /health                 → folio:3333  (unauthenticated liveness)
#   /version                → folio:3333  (unauthenticated — running version +
#                                          upstream release check)
#
# Caddy terminates TLS and forwards Authorization: Bearer untouched for /mcp.
# The EDITOR is NOT behind Basic Auth: the static-server (folio:4173) is the
# sole gate — it accepts an access token via ?token= / Bearer / folio_session
# cookie and serves its own "access token required" page (self-healing into a
# 30-day session cookie) otherwise, so no browser username/password popup an
# access token can't satisfy. Basic Auth is kept ONLY on the /files raw-download
# browser (which is served by Caddy directly, not the app). The /mcp API keeps
# its own Bearer check inside the app.
{
    email {$FOLIO_ACME_EMAIL}
}

{$FOLIO_DOMAIN} {
    encode zstd gzip

    # MCP JSON-RPC + Anthropic Custom Connector endpoint.
    # /version is public alongside /health so a monitor can alert on a stale
    # deployment without holding an API token (it reports only this server's
    # own version + whether upstream has a newer release).
    @mcp path /mcp /mcp/* /tokens/* /health /version
    handle @mcp {
        reverse_proxy folio:3333 {
            flush_interval -1
            header_up Host {host}
        }
    }

    # OAuth 2.0 surface for claude.ai's Custom Connector. /.well-known/* and
    # /oauth/* must NOT be behind basicauth — claude.ai walks them
    # unauthenticated to discover, register, and complete the PKCE dance.
    # The bearer token issued by /oauth/token then gates /mcp.
    @oauth path /.well-known/oauth-* /oauth/*
    handle @oauth {
        reverse_proxy folio:3333 {
            flush_interval -1
            header_up Host {host}
            # Forward proto/host so the engine builds absolute URLs in the
            # OAuth metadata response that point back to the public domain.
            header_up X-Forwarded-Proto {scheme}
            header_up X-Forwarded-Host {host}
        }
    }

    # File browser for rendered exports / project assets. Behind the same
    # Basic Auth as the editor — gives a clickable HTML index at /files/
    # so you can download PNG/SVG/PDF outputs from a browser without SCP.
    # `browse` shows a directory listing; remove it for read-only deep links.
    @files path /files /files/*
    handle @files {
        basicauth {
            {$FOLIO_BASIC_USER} {$FOLIO_BASIC_HASH}
        }
        root * /srv
        file_server browse
    }

    # Jupyter-style URL-token bypass on /editor/events — requests with
    # ?token=* skip basic_auth and delegate to the MCP server which
    # validates the token (open_in_editor mints a fresh 1h token and
    # embeds it in the editor URL it returns).
    @editor_events_with_token {
        path /editor/events
        query token=*
    }
    handle @editor_events_with_token {
        reverse_proxy folio:3333 {
            flush_interval -1
            transport http {
                read_timeout  24h
                write_timeout 24h
            }
        }
    }

    # Fallback: SSE without a token → hand to the backend, which returns a
    # plain 401 (no WWW-Authenticate → no browser popup). The access token /
    # folio_session cookie is the SOLE editor gate — no Basic Auth here.
    @editor_events path /editor/events
    handle @editor_events {
        reverse_proxy folio:3333 {
            flush_interval -1
            transport http {
                read_timeout  24h
                write_timeout 24h
            }
        }
    }

    # Initial editor load with ?token=* → bypass basic_auth. Static-server
    # validates the token, sets a folio_session cookie, returns the editor
    # HTML. Subsequent same-tab navigation rides the cookie matcher below.
    @editor_with_token query token=*
    handle @editor_with_token {
        reverse_proxy folio:4173 {
            header_up Host {host}
        }
    }

    # Once /__token=… set folio_session, the browser carries it on every
    # same-origin request (asset chunks, /favicon.ico, /__project_files/*).
    # Let those through without re-challenging — Caddy substring-matches.
    @editor_with_session header Cookie *folio_session=*
    handle @editor_with_session {
        reverse_proxy folio:4173 {
            header_up Host {host}
        }
    }

    # Everything else → visual editor (vite preview). NO Basic Auth: the
    # static-server (folio:4173) is the SOLE gate. It accepts an access token
    # via ?token= / Bearer / the folio_session cookie, serves its own "access
    # token required" page for anything unauthenticated (which self-heals into
    # a 30-day session cookie on the first valid token), and never shows a
    # browser username/password popup an access token can't satisfy. To also
    # restrict the editor to your own IPs (leaked-link defence), set the
    # app-level FOLIO_ALLOW_IPS allow-list — no proxy change needed.
    handle {
        reverse_proxy folio:4173 {
            header_up Host {host}
        }
    }

    log {
        output stdout
        format console
    }
}
